NODE_ENV=development
PORT=5000

# Set HOST, PORT, USER, PASSWORD to match your local PostgreSQL installation.
# Check postgresql.conf for the actual port (default is 5432 but may differ).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/goibibo_db

JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

CORS_ORIGIN=http://localhost:5173

LOG_LEVEL=info
